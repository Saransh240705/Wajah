# Copy to api/.env and fill in. Never commit api/.env.
STORE=memory
# Optional: MemoryStore persists here (path relative to api/)
# STORE_FILE=../.data/store-live.json
# openaq or cpcb
READINGS_SOURCE=openaq
OPENAQ_API_KEY=
DATA_GOV_API_KEY=
FIRMS_MAP_KEY=
MODEL_PROVIDER=google
MODEL_ID=
GOOGLE_API_KEY=
WORKORDER_POLISH=false
WEB_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Set by the SAM template when deployed:
# READINGS_TABLE= INCIDENTS_TABLE= EVIDENCE_BUCKET= ALERTS_TOPIC_ARN= STATE_MACHINE_ARN=
