{
  "name": "wajah",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:api": "npm run dev -w @wajah/api",
    "dev:web": "npm run dev -w @wajah/web",
    "build:web": "npm run build -w @wajah/web",
    "build": "npm run build -w @wajah/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
